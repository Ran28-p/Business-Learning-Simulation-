{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['xp', 'level'])",
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800000"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "history": {
          "$index": {
            ".validate": "$index.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['date', 'score'])",
            "date": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "module": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "mode": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "portalSync": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$unit": {
          ".validate": "$unit.matches(/^(accounting|excel|sqlpq)$/) && newData.hasChildren(['rev', 'updatedAt', 'hash'])",
          "rev": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4102444800000"
          },
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "hash": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "act": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "data": {
            "$key": {
              ".validate": "newData.isString() && newData.val().length <= 2000000 && (($unit == 'accounting' && $key.matches(/^ACT_MASTER_(STATE|PROGRESS|TAX_STATE)$/)) || ($unit == 'excel' && $key == 'efpg%3Aprogress') || ($unit == 'sqlpq' && $key.matches(/^sqlpq_(progress_v1|dataset_history_v1)$/)))"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "liveRooms": {
      ".read": false,
      ".write": false,
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('meta/host').val() === auth.uid)",
        ".validate": "newData.hasChildren(['meta'])",
        "meta": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['host', 'status', 'timer'])",
          "host": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(lobby|question|reveal|finished)$/)"
          },
          "qIndex": {
            ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 99"
          },
          "qCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "timer": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 300"
          },
          "theme": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "mode": {
            ".validate": "newData.isString() && newData.val().matches(/^(choice|essay)$/)"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "questions": {
          ".read": "auth != null",
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.hasChild('q') && ((newData.child('type').val() === 'essay' && !newData.hasChild('o')) || (!newData.hasChild('type') && newData.hasChild('o')))",
            "q": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 400"
            },
            "type": {
              ".validate": "newData.isString() && newData.val() === 'essay'"
            },
            "o": {
              "$k": {
                ".validate": "$k.matches(/^[0-3]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 150"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "key": {
          ".read": "auth != null && root.child('liveRooms/'+$code+'/meta/host').val() === auth.uid",
          "$i": {
            ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 3) || (newData.hasChildren(['type', 'answer', 'rubric']) && newData.child('type').val() === 'essay' && newData.child('answer').isString() && newData.child('answer').val().length >= 1 && newData.child('answer').val().length <= 2000 && newData.child('rubric').numChildren() >= 2 && newData.child('rubric').numChildren() <= 8 && (!newData.hasChild('e') || (newData.child('e').isString() && newData.child('e').val().length <= 600)))",
            "type": {
              ".validate": "newData.isString() && newData.val() === 'essay'"
            },
            "answer": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
            },
            "rubric": {
              "$k": {
                ".validate": "$k.matches(/^[0-7]$/) && newData.hasChildren(['label', 'keywords'])",
                "label": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
                },
                "keywords": {
                  "$n": {
                    ".validate": "$n.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "e": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "starts": {
          ".read": "auth != null",
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber()"
          }
        },
        "reveal": {
          ".read": "auth != null",
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && ((newData.hasChild('a') && !newData.hasChild('answer')) || (newData.hasChildren(['answer', 'rubric']) && newData.child('answer').isString() && newData.child('answer').val().length <= 2000))",
            "a": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "answer": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "rubric": {
              "$k": {
                ".validate": "$k.matches(/^[0-7]$/) && newData.hasChildren(['label', 'keywords'])",
                "label": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
                },
                "keywords": {
                  "$n": {
                    ".validate": "$n.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "e": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "answers": {
          ".read": "auth != null && root.child('liveRooms/'+$code+'/meta/host').val() === auth.uid",
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/)",
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('liveRooms/'+$code+'/meta/host').val() === auth.uid)",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('liveRooms/'+$code+'/meta/status').val() === 'question' && root.child('liveRooms/'+$code+'/starts/'+$i).exists() && root.child('liveRooms/'+$code+'/starts/'+$i).val() + root.child('liveRooms/'+$code+'/meta/timer').val() * 1000 + 1500 >= now && ((root.child('liveRooms/'+$code+'/questions/'+$i+'/type').val() === 'essay' && newData.hasChild('text') && !newData.hasChild('c')) || (!root.child('liveRooms/'+$code+'/questions/'+$i+'/type').exists() && newData.hasChild('c') && !newData.hasChild('text')))",
              ".validate": "(newData.hasChildren(['c', 't']) && !newData.hasChild('text')) || (newData.hasChildren(['text', 't']) && !newData.hasChild('c'))",
              "c": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
              },
              "t": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "scores": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.hasChildren(['total', 'correct', 'ms'])",
            "total": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "correct": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
